---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/sections/CtaSection.astro';
import { portfolio } from '../../data/site';

const allProjects = portfolio;
const hero = allProjects[0];
const rest = allProjects.slice(1);
---

<Layout title="Réalisations | Studio Kutzu — Communication Digitale au Pays Basque" description="Sites web, identité visuelle, community management : découvrez les projets réalisés par Studio Kutzu au Pays Basque.">
  <section class="pt-32 pb-16 px-6 bg-pink/30">
    <div class="max-w-6xl mx-auto">
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-ink-faint mb-4 block">Réalisations</span>
      <h1 class="font-display text-4xl md:text-5xl font-extrabold tracking-tight text-ink leading-tight mb-6">
        Projets <span class="text-blue">récents</span>
      </h1>
      <p class="text-ink-muted text-lg max-w-2xl leading-relaxed">
        Chaque projet est une histoire. Voici celles que j'ai eu le plaisir d'accompagner.
      </p>
    </div>
  </section>

  <section class="py-16 px-6">
    <div class="max-w-6xl mx-auto">

      <!-- Hero project: full width horizontal card -->
      <a href={`/realisations/${hero.slug}`} class="group block rounded-2xl overflow-hidden bg-surface border border-border transition-all duration-300 hover:shadow-xl hover:shadow-ink/8 hover:-translate-y-1 hover:border-border-strong mb-8">
        <div class="grid grid-cols-1 lg:grid-cols-2">
          <div class="aspect-[16/10] lg:aspect-auto overflow-hidden">
            <img
              src={hero.image.desktop}
              alt={`${hero.client} — ${hero.services.join(', ')}`}
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03]"
            />
          </div>
          <div class="p-8 lg:p-10 flex flex-col justify-center">
            <div class="flex flex-wrap gap-1.5 mb-4">
              {hero.services.map((svc) => (
                <span class="text-xs px-2.5 py-1 rounded-full font-medium bg-pink text-blue">{svc}</span>
              ))}
            </div>
            <h2 class="font-display text-2xl lg:text-3xl font-extrabold text-ink mb-3 group-hover:text-blue transition-colors">{hero.client}</h2>
            <p class="text-ink-muted leading-relaxed mb-4">{hero.description}</p>
            <div class="flex items-center justify-between">
              <p class="text-xs text-ink-faint">{hero.location} · {hero.year}</p>
              <span class="inline-flex items-center gap-1.5 text-sm font-medium text-blue opacity-0 group-hover:opacity-100 transition-opacity">
                Découvrir
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </div>
        </div>
      </a>

      <!-- Remaining projects: 3-column grid with wide cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {rest.map((project, i) => {
          const isWide = i % 5 === 0 || i % 5 === 3;
          return (
            <a
              href={`/realisations/${project.slug}`}
              class={`group block rounded-2xl overflow-hidden bg-surface border border-border transition-all duration-300 hover:shadow-xl hover:shadow-ink/8 hover:-translate-y-1 hover:border-border-strong ${isWide ? 'lg:col-span-2' : ''}`}
            >
              <div class={`overflow-hidden ${isWide ? 'aspect-[2.2/1]' : 'aspect-[4/3]'}`}>
                <img
                  src={project.image.desktop}
                  alt={`${project.client} — ${project.services.join(', ')}`}
                  class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.05]"
                  loading="lazy"
                />
              </div>
              <div class="p-5">
                <div class="flex items-center justify-between mb-2">
                  <h2 class="font-display text-lg font-bold text-ink group-hover:text-blue transition-colors">{project.client}</h2>
                  <div class="flex items-center gap-2">
                    {project.instagram && (
                      <svg class="w-3.5 h-3.5 text-ink-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                    )}
                    {project.website && (
                      <svg class="w-3.5 h-3.5 text-ink-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    )}
                  </div>
                </div>
                <p class="text-sm text-ink-muted mb-3 line-clamp-2">{project.description}</p>
                <div class="flex items-center justify-between">
                  <div class="flex flex-wrap gap-1.5">
                    {project.services.map((svc) => (
                      <span class="text-xs px-2 py-0.5 rounded-full font-medium bg-pink text-blue">{svc}</span>
                    ))}
                  </div>
                  <span class="text-xs text-ink-faint">{project.year}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

    </div>
  </section>

  <CtaSection heading="Votre projet est le prochain ?" text="Discutons de vos besoins autour d'un premier échange sans engagement." buttonLabel="Me contacter" />
</Layout>
