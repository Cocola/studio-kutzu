---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/site';

const faqs = [
  { q: "Combien coûte la création d'un site web ?", a: "Chaque projet est unique. Le tarif dépend de la complexité, du nombre de pages et des fonctionnalités. Je vous propose un devis personnalisé après un premier échange gratuit." },
  { q: "Travaillez-vous uniquement au Pays Basque ?", a: "Je suis basée à Cambo-les-Bains et je travaille principalement avec des professionnels du Pays Basque et des Landes, mais je peux accompagner des projets partout en France." },
  { q: "Proposez-vous des formations ?", a: "Oui, je propose du coaching et de la formation pour vous rendre autonome sur la gestion de vos réseaux sociaux ou de votre site web." },
  { q: "Quelle est la durée d'un accompagnement ?", a: "D'une prestation ponctuelle (création de logo, site web) à un accompagnement mensuel récurrent pour la gestion de vos réseaux sociaux." },
];
---

<Layout title="Services | Studio Kutzu — Communication Digitale au Pays Basque" description="Gestion des réseaux sociaux, création de sites web, identité visuelle et stratégie digitale. Studio Kutzu à Cambo-les-Bains.">
  <!-- Hero -->
  <section class="pt-32 pb-20 px-6 bg-pink/30">
    <div class="max-w-4xl mx-auto">
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-ink-faint mb-4 block">Services</span>
      <h1 class="font-display text-4xl md:text-5xl font-extrabold tracking-tight text-ink leading-tight mb-6">
        Des solutions adaptées à <span class="text-blue">vos besoins</span>
      </h1>
      <p class="text-ink-muted text-lg max-w-2xl leading-relaxed">
        Du coaching ponctuel à l'accompagnement long terme, je m'adapte à votre budget et vos objectifs.
      </p>
    </div>
  </section>

  <!-- Services -->
  <section class="py-24 px-6">
    <div class="max-w-4xl mx-auto flex flex-col gap-24">
      {services.map((service, i) => (
        <div id={service.slug} class="scroll-mt-24">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background-color: #FFE7E9;">
              <svg class="w-5 h-5" style="color: #273CC6;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                {i === 0 && <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>}
                {i === 1 && <><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></>}
                {i === 2 && <><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-5"/></>}
                {i === 3 && <><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></>}
              </svg>
            </div>
            <div>
              <h2 class="font-display text-2xl font-extrabold text-ink">{service.name}</h2>
              <p class="text-ink-muted leading-relaxed mt-2">{service.description}</p>
            </div>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 ml-14">
            {service.features.map((feature) => (
              <div class="px-4 py-3 rounded-xl text-center text-sm font-medium text-ink" style="background-color: #FFF0F1;">
                {feature}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 px-6" style="background-color: #FFF0F1;">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink mb-10 text-center">Questions fréquentes</h2>
      <div class="flex flex-col gap-3">
        {faqs.map((faq) => (
          <details class="group bg-surface rounded-xl border border-border p-5 cursor-pointer">
            <summary class="flex items-center justify-between font-display font-bold text-ink text-sm list-none">
              {faq.q}
              <svg class="w-4 h-4 text-ink-faint flex-shrink-0 ml-4 transition-transform duration-300 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="text-ink-muted leading-relaxed mt-3 text-sm">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink mb-4">Un projet en tête ?</h2>
      <p class="text-ink-muted text-lg mb-8">Premier échange découverte sans engagement.</p>
      <a href="/contact" class="inline-flex items-center gap-3 px-8 py-4 bg-blue text-white rounded-full text-lg font-bold font-display transition-all duration-300 hover:bg-blue-dark hover:-translate-y-0.5">
        Parlons-en
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
  })} />
</Layout>
