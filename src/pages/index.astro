---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import { services, portfolio, siteConfig } from '../data/site';
---

<Layout title="Studio Kutzu | Communication Digitale au Pays Basque">
  <HeroSection />

  <!-- ─── Services ─── -->
  <section class="py-24 px-6" id="services">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-16 items-start">
        <div class="lg:sticky lg:top-32">
          <span class="text-xs font-medium uppercase tracking-[0.2em] text-gold-text mb-3 block">Services</span>
          <h2 class="font-display text-3xl md:text-4xl font-extrabold tracking-tight text-ink mb-4">
            Ce que je fais pour vous
          </h2>
          <p class="text-ink-muted leading-relaxed max-w-sm">
            Une approche personnalisée, adaptée à votre budget et vos objectifs. Du coaching ponctuel à l'accompagnement long terme.
          </p>
        </div>

        <div class="flex flex-col divide-y divide-border">
          {services.map((service, i) => (
            <a href={`/services#${service.slug}`} class="group flex items-start gap-5 py-7 first:pt-0 last:pb-0 transition-colors duration-300">
              <div class="w-10 h-10 rounded-lg bg-pink flex items-center justify-center flex-shrink-0 mt-0.5 group-hover:bg-blue/10 transition-colors duration-300">
                <svg class="w-5 h-5 text-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {i === 0 && <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>}
                  {i === 1 && <><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></>}
                  {i === 2 && <><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-5"/></>}
                  {i === 3 && <><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></>}
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-display text-lg font-bold text-ink mb-1 group-hover:text-blue transition-colors">
                  {service.name}
                </h3>
                <p class="text-sm text-ink-muted leading-relaxed">{service.description}</p>
                <p class="text-xs text-ink-faint mt-2">{service.features.join(' · ')}</p>
              </div>
              <svg class="w-4 h-4 text-ink-faint opacity-0 group-hover:opacity-100 group-hover:text-blue transition-all duration-300 flex-shrink-0 mt-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Réalisations ─── -->
  <section class="pt-20 pb-28 px-6 bg-surface-alt" id="realisations">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12 flex-wrap gap-4">
        <div>
          <span class="text-xs font-medium uppercase tracking-[0.2em] text-gold-text mb-3 block">Réalisations</span>
          <h2 class="font-display text-3xl md:text-4xl font-extrabold tracking-tight text-ink">
            Projets récents
          </h2>
        </div>
        <a href="/realisations" class="text-sm font-semibold text-blue hover:underline underline-offset-4 transition-colors">
          Tout voir →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {portfolio.filter(p => p.featured).map((project) => (
          <div class="group rounded-2xl overflow-hidden bg-surface border border-border transition-all duration-300 hover:shadow-md">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={project.image.desktop}
                alt={`${project.client} — ${project.services.join(', ')}`}
                width="640"
                height="480"
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-display text-lg font-bold text-ink group-hover:text-blue transition-colors">{project.client}</h3>
                {project.website && (
                  <a href={`https://${project.website}`} target="_blank" rel="noopener noreferrer" class="text-ink-faint hover:text-blue transition-colors p-1" aria-label={`Visiter ${project.website}`}>
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                )}
              </div>
              <p class="text-sm text-ink-muted mb-3 line-clamp-2">{project.description}</p>
              <div class="flex flex-wrap gap-1.5">
                {project.services.map((svc: string) => (
                  <span class="text-xs px-2.5 py-1 rounded-full font-medium bg-pink text-blue">{svc}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── À propos ─── -->
  <section class="py-28 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-16 items-center">
      <div>
        <span class="text-xs font-medium uppercase tracking-[0.2em] text-gold-text mb-3 block">À propos</span>
        <h2 class="font-display text-3xl md:text-4xl font-extrabold tracking-tight text-ink leading-tight mb-6">
          Maider Gaicotchea
        </h2>
        <blockquote class="text-xl md:text-2xl font-display font-bold text-ink leading-snug mb-6 border-l-2 border-gold pl-5">
          {siteConfig.tagline}
        </blockquote>
        <p class="text-ink-muted leading-relaxed mb-8">
          Installée à Cambo-les-Bains, j'accompagne les professionnels du Pays Basque dans leurs projets de communication depuis 2022. Derrière chaque projet, il y a une histoire, des valeurs et des engagements à défendre.
        </p>
        <a href="/a-propos" class="inline-flex items-center gap-2 text-sm font-semibold text-blue hover:gap-3 transition-all duration-300">
          En savoir plus
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div>
        <div class="aspect-[4/5] rounded-2xl overflow-hidden">
          <img src="/maider.jpg" alt="Maider Gaicotchea, fondatrice de Studio Kutzu" width="640" height="800" class="w-full h-full object-cover" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CTA ─── -->
  <section class="mx-6 mb-20 rounded-3xl py-20 px-8" style="background-color: #FFE7E9;">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-display text-3xl md:text-4xl font-extrabold tracking-tight text-ink leading-tight mb-4">
        Un projet en tête ?
      </h2>
      <p class="text-ink-muted text-lg mb-10 max-w-md mx-auto">
        Échangeons sur vos besoins. Je vous propose un premier appel découverte sans engagement.
      </p>
      <a href="/contact" class="inline-flex items-center gap-3 px-8 py-4 bg-blue text-white rounded-full text-lg font-bold font-display transition-all duration-300 hover:bg-blue-dark hover:shadow-lg hover:shadow-blue/20 hover:-translate-y-0.5 focus-visible:outline-offset-4">
        Parlons-en
        <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Studio Kutzu",
    "description": "Studio de communication digitale au Pays Basque — identité visuelle, sites web, réseaux sociaux.",
    "url": "https://studiokutzu.com",
    "logo": "https://studiokutzu.com/logo.svg",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Cambo-les-Bains",
      "postalCode": "64250",
      "addressCountry": "FR",
      "addressRegion": "Pays Basque"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": 43.3594, "longitude": -1.4036 },
    "areaServed": ["Cambo-les-Bains", "Bayonne", "Biarritz", "Anglet", "Saint-Jean-de-Luz", "Pays Basque"],
    "founder": { "@type": "Person", "name": "Maider Gaicotchea" },
    "foundingDate": "2022",
    "sameAs": [
      "https://www.instagram.com/studiokutzu/",
      "https://www.linkedin.com/company/studio-kutzu",
      "https://www.facebook.com/183023188225288"
    ]
  })} />
</Layout>
