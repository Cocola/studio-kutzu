---
import Layout from '../layouts/Layout.astro';
import { portfolio } from '../data/site';
---

<Layout title="Réalisations | Studio Kutzu — Communication Digitale au Pays Basque" description="Sites web, identité visuelle, community management : découvrez les projets réalisés par Studio Kutzu au Pays Basque.">
  <section class="pt-32 pb-16 px-6 bg-pink/30">
    <div class="max-w-6xl mx-auto">
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-ink-faint mb-4 block">Réalisations</span>
      <h1 class="font-display text-4xl md:text-5xl font-extrabold tracking-tight text-ink leading-tight mb-6">
        Projets <span class="text-blue">récents</span>
      </h1>
      <p class="text-ink-muted text-lg max-w-2xl leading-relaxed">
        Chaque projet est une histoire. Voici celles que j'ai eu le plaisir d'accompagner.
      </p>
    </div>
  </section>

  <section class="py-16 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
      {portfolio.map((project) => (
        <div class="group rounded-2xl overflow-hidden bg-surface border border-border transition-all duration-300 hover:shadow-md">
          <div class="aspect-[16/10] overflow-hidden">
            <img
              src={project.image.desktop}
              alt={`${project.client} — ${project.services.join(', ')}`}
              class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-2">
              <h2 class="font-display text-xl font-bold text-ink group-hover:text-blue transition-colors">{project.client}</h2>
              <div class="flex items-center gap-3">
                {project.instagram && (
                  <a href={project.instagram} target="_blank" rel="noopener noreferrer" class="text-ink-faint hover:text-blue transition-colors" aria-label={`Instagram de ${project.client}`}>
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                  </a>
                )}
                {project.website && (
                  <a href={`https://${project.website}`} target="_blank" rel="noopener noreferrer" class="text-ink-faint hover:text-blue transition-colors" aria-label={`Visiter ${project.website}`}>
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                )}
              </div>
            </div>
            <p class="text-sm text-ink-muted mb-1">{project.description}</p>
            <p class="text-xs text-ink-faint mb-4">{project.location} · {project.year}</p>
            <div class="flex flex-wrap gap-1.5">
              {project.services.map((svc) => (
                <span class="text-xs px-2 py-0.5 rounded-full font-medium" style="background-color: #FFE7E9; color: #273CC6;">{svc}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-6 mb-20 rounded-3xl py-20 px-8" style="background-color: #FFE7E9;">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink mb-4">Votre projet est le prochain ?</h2>
      <p class="text-ink-muted text-lg mb-8">Discutons de vos besoins autour d'un premier échange sans engagement.</p>
      <a href="/contact" class="inline-flex items-center gap-3 px-8 py-4 bg-blue text-white rounded-full text-lg font-bold font-display transition-all duration-300 hover:bg-blue-dark hover:-translate-y-0.5">
        Me contacter
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>
</Layout>
