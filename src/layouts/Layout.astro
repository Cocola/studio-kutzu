---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { DEFAULT_LOCALE, HTML_LANG, LOCALES, OG_LOCALE, type Locale } from '../i18n/config';
import { getLocaleFromUrl, localePath, localize, stripLocale, t } from '../i18n/utils';
import { siteConfig } from '../data/site';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const detectedLocale = getLocaleFromUrl(Astro.url);
const { title, description, locale = detectedLocale } = Astro.props;

const resolvedDescription = description ?? t('meta.home.description', locale);

const canonicalPath = localePath(Astro.url.pathname, locale);
const canonicalURL = new URL(canonicalPath, Astro.site);

const cleanPath = stripLocale(canonicalPath);
const alternates = LOCALES.map((loc) => ({
  hreflang: HTML_LANG[loc],
  href: new URL(localePath(cleanPath, loc), Astro.site).toString(),
}));
const xDefaultHref = new URL(localePath(cleanPath, DEFAULT_LOCALE), Astro.site).toString();

const phoneE164 = `+33${siteConfig.phone.replace(/\D/g, '').replace(/^0/, '')}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://studiokutzu.com/#business',
  name: siteConfig.name,
  alternateName: 'Kutzu',
  description: t('meta.home.description', locale),
  url: 'https://studiokutzu.com/',
  telephone: phoneE164,
  email: siteConfig.email,
  image: 'https://studiokutzu.com/og-image.jpg',
  logo: 'https://studiokutzu.com/logo.svg',
  priceRange: '€€',
  founder: {
    '@type': 'Person',
    name: siteConfig.founder,
    jobTitle: localize(siteConfig.founderTitle, locale),
  },
  foundingDate: String(siteConfig.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.address,
    postalCode: siteConfig.postalCode,
    addressLocality: localize(siteConfig.city, locale),
    addressRegion: localize(siteConfig.region, locale),
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 43.3597,
    longitude: -1.4028,
  },
  areaServed: [
    { '@type': 'City', name: 'Cambo-les-Bains' },
    { '@type': 'City', name: 'Itxassou' },
    { '@type': 'City', name: 'Louhossoa' },
    { '@type': 'City', name: 'Espelette' },
    { '@type': 'City', name: 'Ustaritz' },
    { '@type': 'City', name: 'Larressore' },
    { '@type': 'City', name: 'Ossès' },
    { '@type': 'City', name: 'Saint-Étienne-de-Baïgorry' },
    { '@type': 'City', name: 'Bassussarry' },
    { '@type': 'City', name: 'Sare' },
    { '@type': 'City', name: 'Briscous' },
    { '@type': 'City', name: 'Bayonne' },
    { '@type': 'City', name: 'Biarritz' },
    { '@type': 'City', name: 'Anglet' },
    { '@type': 'City', name: 'Saint-Jean-de-Luz' },
    { '@type': 'Place', name: 'Pays Basque' },
    { '@type': 'Place', name: 'Nouvelle-Aquitaine' },
    { '@type': 'Country', name: 'France' },
  ],
  sameAs: [siteConfig.instagram, siteConfig.linkedin, siteConfig.facebook],
  inLanguage: LOCALES.map((l) => HTML_LANG[l]),
};
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:site_name" content="Studio Kutzu" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta property="og:image" content="https://studiokutzu.com/og-image.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Studio Kutzu" />
    <meta name="twitter:image" content="https://studiokutzu.com/og-image.jpg" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <ClientRouter />
    <meta name="theme-color" content="#273CC6" />

    <link rel="preload" href="/fonts/cabinet-grotesk-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />

  </head>
  <body class="overflow-x-hidden">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[99999] focus:px-4 focus:py-2 focus:bg-blue focus:text-white focus:rounded-lg focus:text-sm focus:font-medium">{t('common.skipToContent', locale)}</a>

    <div class="page-content">
      <Header locale={locale} />
      <main id="main">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>

    <script>
      import Lenis from 'lenis';

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let currentLenis: InstanceType<typeof Lenis> | null = null;

      function stopSmoothScroll() {
        currentLenis?.destroy();
        currentLenis = null;
      }

      // Progressive enhancement only: neither visibility nor navigation depends
      // on this script, session storage, a timer or an animation completing.
      function initSmoothScroll() {
        stopSmoothScroll();
        if (reducedMotion.matches) return;
        currentLenis = new Lenis({
          autoRaf: true,
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        });
      }

      initSmoothScroll();
      document.addEventListener('astro:before-swap', stopSmoothScroll);
      document.addEventListener('astro:page-load', initSmoothScroll);
      reducedMotion.addEventListener('change', initSmoothScroll);
    </script>
  </body>
</html>
