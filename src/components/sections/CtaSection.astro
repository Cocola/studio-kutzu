---
interface Props {
  heading?: string;
  text?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  heading = 'Un projet en tête ?',
  text = 'Premier échange découverte sans engagement.',
  buttonLabel = 'Parlons-en',
  buttonHref = '/contact',
} = Astro.props;
---

<section class="mx-6 mb-20 rounded-3xl py-20 px-8 bg-pink">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink mb-4">{heading}</h2>
    <p class="text-ink-muted text-lg mb-8">{text}</p>
    <a href={buttonHref} class="inline-flex items-center gap-3 px-8 py-4 bg-blue text-white rounded-full text-lg font-bold font-display transition-all duration-300 hover:bg-blue-dark hover:-translate-y-0.5">
      {buttonLabel}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
</section>
