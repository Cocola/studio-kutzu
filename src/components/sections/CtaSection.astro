---
import { type Locale } from '../../i18n/config';
import { getLocaleFromUrl, localePath, t } from '../../i18n/utils';

interface Props {
  locale?: Locale;
  heading?: string;
  text?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const {
  locale = getLocaleFromUrl(Astro.url),
  heading,
  text,
  buttonLabel,
  buttonHref,
} = Astro.props;

const resolvedHeading = heading ?? t('home.cta.heading', locale);
const resolvedText = text ?? t('home.cta.text', locale);
const resolvedButton = buttonLabel ?? t('cta.talk', locale);
const resolvedHref = buttonHref ?? localePath('/contact', locale);
---

<section class="mx-6 mb-20 rounded-3xl py-20 px-8 bg-pink">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink mb-4">{resolvedHeading}</h2>
    <p class="text-ink-muted text-lg mb-8">{resolvedText}</p>
    <a href={resolvedHref} class="inline-flex items-center gap-3 px-8 py-4 bg-blue text-white rounded-full text-lg font-bold font-display transition-all duration-300 hover:bg-blue-dark hover:-translate-y-0.5">
      {resolvedButton}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
</section>
