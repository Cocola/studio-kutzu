---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height' | 'alt'> {
  src: string;
  alt: string;
  sizes: string;
  width?: number | string;
  height?: number | string;
}

// Import the originals through Astro's asset pipeline while retaining their
// public URLs for existing external links. A raw public URL is not optimized.
const originals = import.meta.glob<{ default: ImageMetadata }>([
  '../../../public/portfolio/**/*.{jpg,jpeg,png,webp}',
  '../../../public/maider.jpg',
], { eager: true });

const { src, sizes, width: _width, height: _height, ...attributes } = Astro.props;
const original = originals[`../../../public${src}`]?.default;
if (!original) throw new Error(`Image locale introuvable : ${src}`);
const width = Math.min(original.width, 1280);
const widths = [...new Set([360, 640, 960, width].filter((size) => size <= width))].sort((a, b) => a - b);
---

<Image src={original} width={width} widths={widths} sizes={sizes} format="webp" quality={80} {...attributes} />
