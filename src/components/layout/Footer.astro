---
const currentYear = new Date().getFullYear();
const footerLinks = [
  {
    title: 'Services',
    links: [
      { label: 'Réseaux sociaux', href: '/services#social-media' },
      { label: 'Sites Web', href: '/services#sites-web' },
      { label: 'Identité visuelle', href: '/services#identite-visuelle' },
      { label: 'Stratégie digitale', href: '/services#strategie' },
    ],
  },
  {
    title: 'Studio',
    links: [
      { label: 'À propos', href: '/a-propos' },
      { label: 'Réalisations', href: '/realisations' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Suivez-moi',
    links: [
      { label: 'Instagram', href: 'https://www.instagram.com/studiokutzu/', external: true },
      { label: 'LinkedIn', href: 'https://www.linkedin.com/company/studio-kutzu', external: true },
      { label: 'Facebook', href: 'https://www.facebook.com/183023188225288', external: true },
    ],
  },
];
---

<footer class="border-t border-border mt-32">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <div>
        <a href="/" class="flex items-center gap-3 mb-4">
          <img src="/logo.svg" alt="Studio Kutzu" class="h-10 w-10" />
          <span class="text-lg font-bold font-display">Studio Kutzu</span>
        </a>
        <p class="text-sm text-ink-muted leading-relaxed">
          Communication digitale au Pays Basque.<br />
          Raconter votre histoire de manière authentique.
        </p>
        <p class="text-sm text-ink-muted mt-4">📍 Cambo-les-Bains, 64250</p>
      </div>

      {footerLinks.map((section) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-ink mb-4">
            {section.title}
          </h3>
          <ul class="flex flex-col gap-3">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-ink-muted hover:text-blue transition-colors"
                  {...('external' in link && link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-ink-faint">
        &copy; {currentYear} Studio Kutzu — Maider Gaicotchea. Tous droits réservés.
      </p>
      <p class="text-xs text-ink-faint">
        Cambo-les-Bains · Bayonne · Biarritz · Pays Basque
      </p>
    </div>
  </div>
</footer>
