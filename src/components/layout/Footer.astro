---
import { type Locale } from '../../i18n/config';
import { getLocaleFromUrl, localePath, t } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = getLocaleFromUrl(Astro.url) } = Astro.props;

const currentYear = new Date().getFullYear();

import type { Bilingual } from '../../i18n/config';
import { localize } from '../../i18n/utils';

interface FooterLink {
  href: string;
  label: Bilingual;
}

const serviceLinks: FooterLink[] = [
  { href: localePath('/services#social-media', locale), label: { fr: 'Réseaux sociaux', eu: 'Sare sozialak' } },
  { href: localePath('/services#sites-web', locale), label: { fr: 'Sites Web & E-commerce', eu: 'Webguneak eta e-merkataritza' } },
  { href: localePath('/services#identite-visuelle', locale), label: { fr: 'Identité visuelle & Print', eu: 'Nortasun bisuala' } },
  { href: localePath('/services#marketing-digital', locale), label: { fr: 'Marketing digital', eu: 'Marketing digitala' } },
];

const studioLinks: FooterLink[] = [
  { href: localePath('/a-propos', locale), label: { fr: 'À propos', eu: 'Nitaz' } },
  { href: localePath('/realisations', locale), label: { fr: 'Réalisations', eu: 'Lanak' } },
  { href: localePath('/contact', locale), label: { fr: 'Contact', eu: 'Harremanak' } },
];

const socialLinks = [
  { label: 'Instagram', href: 'https://www.instagram.com/studiokutzu/' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/kutzu/' },
  { label: 'Facebook', href: 'https://www.facebook.com/183023188225288' },
];

const footerSections = [
  { titleKey: 'footer.title.services', links: serviceLinks },
  { titleKey: 'footer.title.studio', links: studioLinks },
];
---

<footer class="border-t border-border mt-32">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <div>
        <a href={localePath('/', locale)} class="flex items-center gap-3 mb-4">
          <img src="/logo.svg" alt="Studio Kutzu" class="h-10 w-10" />
          <span class="text-lg font-bold font-display">Studio Kutzu</span>
        </a>
        <p class="text-sm text-ink-muted leading-relaxed">
          {t('footer.tagline.line1', locale)}<br />
          {t('footer.tagline.line2', locale)}
        </p>
        <p class="text-sm text-ink-muted mt-4 inline-flex items-center gap-1.5">
          <svg class="w-4 h-4 text-blue flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {t('footer.addressChip', locale)}
        </p>
      </div>

      {footerSections.map((section) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-ink mb-4">
            {t(section.titleKey, locale)}
          </h3>
          <ul class="flex flex-col gap-3">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-ink-muted hover:text-blue transition-colors inline-flex items-center gap-1"
                >
                  {localize(link.label, locale)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink mb-4">
          {t('footer.title.follow', locale)}
        </h3>
        <ul class="flex flex-col gap-3">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-ink-muted hover:text-blue transition-colors inline-flex items-center gap-1"
              >
                {link.label}
                <span class="sr-only">{t('common.newWindow', locale)}</span>
                <svg class="w-3 h-3 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-ink-faint">
        &copy; {currentYear} Studio Kutzu — Maider Gaicotchea. {t('footer.copyright', locale)}
      </p>
      <p class="text-xs text-ink-faint">
        {t('footer.locations', locale)}
      </p>
    </div>
  </div>
</footer>
